# Server Environment Variables Template
# Copy this file to .env and fill in your actual values

# Payment Configuration
# Set to 'true' to require payment before booking, 'false' to allow free access
IS_PAYMENT_REQUIRES=false

# MercadoPago Access Token
# Get this from your MercadoPago dashboard
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN_HERE

# Google Calendar Scheduling URL
# Your Google Calendar appointment scheduling link
GOOGLE_CALENDAR_URL=https://calendar.app.google/YOUR_CALENDAR_ID

# Social Media Links
# LinkedIn company page URL
LINKEDIN_URL=https://linkedin.com/company/your-company

# Twitter/X profile URL
TWITTER_URL=https://twitter.com/your-handle

# Contact email address
EMAIL=contact@yourcompany.com
